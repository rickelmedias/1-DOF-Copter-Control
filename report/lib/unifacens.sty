% Manual REV.16: capa p.3 adaptada conforme slides; rosto conforme README.
\newcommand{\coordenadoria}[1]{\def\@coordenadoria{#1}}
\newcommand{\subtitulo}[1]{\def\@subtitulo{#1}}
\newcommand{\integranteum}[1]{\def\@integranteum{#1}}
\newcommand{\integrantedois}[1]{\def\@integrantedois{#1}}
\newcommand{\integrantetres}[1]{\def\@integrantetres{#1}}
\newcommand{\integrantequatro}[1]{\def\@integrantequatro{#1}}
\newcommand{\integrantecinco}[1]{\def\@integrantecinco{#1}}
\coordenadoria{}\subtitulo{}
\integranteum{}\integrantedois{}\integrantetres{}\integrantequatro{}\integrantecinco{}
% RA dos integrantes, exibido somente na folha de rosto.
\newcommand{\raum}[1]{\def\@raum{#1}}
\newcommand{\radois}[1]{\def\@radois{#1}}
\newcommand{\ratres}[1]{\def\@ratres{#1}}
\newcommand{\raquatro}[1]{\def\@raquatro{#1}}
\newcommand{\racinco}[1]{\def\@racinco{#1}}
\raum{}\radois{}\ratres{}\raquatro{}\racinco{}
\newcommand{\autorra}[2]{\ifx#1\empty\else\MakeUppercase{#1}\ifx#2\empty\else{} -- RA #2\fi\par\fi}
\newcommand{\autoresrostofacens}{%
 \autorra{\@integranteum}{\@raum}\autorra{\@integrantedois}{\@radois}%
 \autorra{\@integrantetres}{\@ratres}\autorra{\@integrantequatro}{\@raquatro}%
 \autorra{\@integrantecinco}{\@racinco}}
\newcommand{\autoresfacens}{%
 \MakeUppercase{\@integranteum}\par
 \MakeUppercase{\@integrantedois}\par
 \MakeUppercase{\@integrantetres}\par
 \MakeUppercase{\@integrantequatro}\par
 \MakeUppercase{\@integrantecinco}\par}
\newcommand{\titulofacens}{%
 \MakeUppercase{\imprimirtitulo}%
 \ifx\@subtitulo\empty\else: \@subtitulo\fi\par}
